# Kaarya (replaced Trello, 2026-06-29)
# JWT: grab from the Hub UI -> browser Local Storage -> key "vcm_token".
# This is a user-session token and expires with the Hub session (~30 days), so
# the cron will 401 silently once it lapses. Pending: a long-lived
# service-account token from the Kaarya team.
KAARYA_JWT=eyJ...
# Optional — defaults to the value below. Note the host is kaaryaAPI.*;
# kaarya.jennifer-in.com is the UI and 405s on POST.
KAARYA_MCP_URL=https://kaaryaapi.jennifer-in.com/api/mcp

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Google Service Account (from your service account JSON — paste each field separately)
GCP_PROJECT_ID=testing-one-490804
GCP_PRIVATE_KEY_ID=your_private_key_id
GCP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GCP_CLIENT_EMAIL=chat-bot@testing-one-490804.iam.gserviceaccount.com
GCP_CLIENT_ID=104261218426171206814

# Sonal's calendar ID — find it in Google Calendar → Settings → "Integrate calendar"
# Usually just her email address e.g. sonal@valuecart.in
GCAL_CALENDAR_ID=sonal@valuecart.in

# Test mode: "true" (the default) routes ALL email to TEST_EMAIL instead of the
# real recipients. Flip to false only once every board has been eyeballed live.
TEST_MODE=true
TEST_EMAIL=aryan@valuecart.in

# Email is sent via the Valuecart Email MCP — no Gmail config needed
